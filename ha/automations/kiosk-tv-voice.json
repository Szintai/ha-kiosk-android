        "(állítsd|tedd|legyen) a (tévé|tv) hangerejét {volume}",
        "(állítsd|tedd) a hangerőt {volume}",
        "hangerő {volume}"
      ],
      "id": "vol_set"
    },
    {
      "trigger": "conversation",
      "command": [
        "némítsd [el] a (tévét|hangot)",
        "némítsd el",
        "némítás"
      ],
      "id": "mute"
    },
    {
      "trigger": "conversation",
      "command": [
        "kapcsold vissza a hangot",
        "szólaljon meg a tévé",
        "némítás ki"
      ],
      "id": "unmute"
    },
    {
      "trigger": "conversation",
      "command": [
        "következő csatorna",
        "a következő csatorna",
        "csatorna fel"
      ],
      "id": "ch_up"
    },
    {
      "trigger": "conversation",
      "command": [
        "előző csatorna",
        "az előző csatorna",
        "csatorna le"
      ],
      "id": "ch_down"
    },
    {
      "trigger": "conversation",
