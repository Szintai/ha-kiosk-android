{
  "alias": "Kiosk: TV hangparancsok",
  "description": "Magyar hangparancsok a Samsung TV-hez és a lámpákhoz (generálva: ha/scripts/gen_tv_voice.py)",
  "mode": "single",
  "triggers": [
    {
      "trigger": "conversation",
      "command": [
        "kapcsold be a (tévét|televíziót|tv)",
        "indítsd be a (tévét|televíziót|tv)",
        "tévé be"
      ],
      "id": "tv_on"
    },
    {
      "trigger": "conversation",
      "command": [
        "kapcsold ki a (tévét|televíziót|tv)",
        "tévé ki"
      ],
      "id": "tv_off"
    },
    {
      "trigger": "conversation",
      "command": [
        "(hangosítsd|növeld|emeld) fel a (tévét|tv|hangerőt)",
        "hangosítsd fel",
        "hangosabban",
        "emeld a hangerőt"
      ],
      "id": "vol_up"
    },
    {
      "trigger": "conversation",
      "command": [
        "(halkítsd|csökkentsd|vedd) le a (tévét|tv|hangerőt)",
        "halkítsd le",
        "halkabban",
        "csökkentsd a hangerőt"
      ],
      "id": "vol_down"
    },
    {
      "trigger": "conversation",
      "command": [
